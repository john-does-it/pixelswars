{
	"name": "pixelswars",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1",
		"prepare": "node --experimental-strip-types scripts/sync-assets.ts && svelte-kit sync",
		"predev": "node --experimental-strip-types scripts/sync-assets.ts",
		"prebuild": "node --experimental-strip-types scripts/sync-assets.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "node --experimental-strip-types --test tests/*.test.ts",
		"test:e2e": "playwright test",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@playwright/test": "^1.58.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@types/node": "^22.20.2",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.9.0",
		"vite": "^6.4.0"
	},
	"engines": {
		"node": ">=22.14.0"
	}
}
