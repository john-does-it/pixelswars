# Metered app name or hostname, e.g. pixelswars or pixelswars.metered.live.
# Copy to .env.local and restart Vite after changing these values.
VITE_METERED_APP=

# Credential-scoped TURN API key, designed for browser use.
# NEVER put the account Secret Key or Project API Key here.
# This value is included in the public browser bundle, even from a GitHub Secret.
VITE_METERED_TURN_API_KEY=

# Local diagnostics only. Normal play uses direct connections when possible.
VITE_TURN_RELAY_ONLY=false
